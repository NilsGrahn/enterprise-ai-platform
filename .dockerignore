# Virtual environment — rebuilt inside the image from requirements.txt
.venv/
venv/

# Git history — not needed at runtime
.git/
.gitignore

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/

# Raw data — mounted as a volume, not baked into the image
data/raw/

# Trained models — mounted as a volume, not baked in
artifacts/

# Real secrets — compose injects environment variables instead
.env

# Editor and OS noise
.vscode/
.idea/
.DS_Store

# Notebooks and scratch files
notebooks/
scratch_*.py

# Docs are not needed at runtime
docs/